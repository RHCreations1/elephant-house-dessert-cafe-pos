rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : (signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous' ? 'cashier' : 'none');
    }
    function supervisorOrAdmin() { return role() in ['supervisor', 'admin']; }
    function adminOnly() { return role() == 'admin'; }
    match /sales/{billId} {
      allow read: if supervisorOrAdmin() ||
        (role() == 'cashier' && resource.data.cashierUid == request.auth.uid);
      allow create: if role() == 'cashier' &&
        request.resource.data.cashierUid == request.auth.uid &&
        request.resource.data.panel in [1, 2] &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.items is list;
      allow update: if supervisorOrAdmin();
      allow delete: if false;
    }
    match /stock/{stockId} {
      allow read, create, update: if supervisorOrAdmin();
      allow delete: if false;
    }
    match /config/{configId} {
      allow read: if signedIn();
      allow write: if adminOnly();
    }
    match /maintenanceBackups/{backupId}/{document=**} {
      allow read: if adminOnly();
      allow write: if false;
    }
    match /maintenanceBackups/{backupId} {
      allow read: if adminOnly();
      allow write: if false;
    }
    match /auditLogs/{logId} {
      allow read: if adminOnly();
      allow write: if false;
    }
    match /authPinAttempts/{attemptId} {
      allow read, write: if false;
    }
  }
}